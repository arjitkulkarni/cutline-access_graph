# CUTLINE API configuration. Copy to backend/.env for local development (never commit .env).
# In production (Railway) set the same names in the service's Variables tab; no .env file is used there.
# Full reference (purpose, required/optional, platform, secret or not): docs/DEPLOYMENT.md, section 6.
# Comments stay on their own lines: Docker --env-file and dashboard importers keep inline "# ..." text.

# --- Runtime ----------------------------------------------------------------------------------
# development (default) | production. Production hides internals in error responses, hides the
# FalkorDB hostname in /api/health, and allows no browser origin unless CORS_ORIGINS lists it.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Local only. The Docker image binds $PORT (Railway injects it) and sets BACKEND_PORT to match, because
# runtime verification calls this API at http://127.0.0.1:$BACKEND_PORT. Set neither on Railway.
BACKEND_PORT=8000

# --- FalkorDB ---------------------------------------------------------------------------------
# Local Docker:   FALKORDB_HOST=localhost  FALKORDB_PORT=6379  (no username/password)
# FalkorDB Cloud: host:port from the instance's Connectivity tab; default user is "falkordb";
#                 Free tier has no TLS (FALKORDB_TLS=false); paid tiers may enable TLS at creation.
# Required in production: FALKORDB_HOST, FALKORDB_PORT; for FalkorDB Cloud also USERNAME and PASSWORD.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
# Secret.
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# TLS only: verify the certificate matches FALKORDB_HOST; PEM text of a private CA (public CAs need nothing).
FALKORDB_TLS_CHECK_HOSTNAME=true
FALKORDB_TLS_CA_CERT=
# Active policy graph; the ledger (<graph>__ledger) and candidate graphs derive their names from it.
FALKORDB_GRAPH=cutline_dev
FALKORDB_CONNECT_TIMEOUT=5
FALKORDB_SOCKET_TIMEOUT=15

# --- App --------------------------------------------------------------------------------------
# Enables scenario reset and the live-challenge mutations (keep true for the demo).
DEMO_MODE=true
# Comma-separated browser origins allowed to call the API directly. The console proxies /api on its server
# and does not need CORS; list the console URL anyway. Unset: localhost:3000 in development, none in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for more origins, e.g. Vercel previews: ^https://cutline-[a-z0-9-]+-<team>\.vercel\.app$
CORS_ORIGIN_REGEX=
# Where runtime verification sends real HTTP requests (defaults to this API itself). On Vercel the backend
# service's self-binding in vercel.json injects it at runtime: never set it there.
DEMO_API_BASE_URL=

# --- Independent enforcement engine for runtime verification --------------------------------
# reference = built-in fixpoint closure; opa = Open Policy Agent serving policies/cutline_authz.rego
AUTHZ_ENGINE=reference
# Required when AUTHZ_ENGINE=opa.
OPA_URL=

# --- Planner budget ---------------------------------------------------------------------------
MAX_DEPTH=6
MAX_CANDIDATES=24
MAX_CUT_SIZE=3
CANDIDATE_WORKERS=4

# --- Optional LLM agent (Track 01). Without a key the agent runs the same tools deterministically.
# Secret; backend only, never give it to the frontend.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TURNS=8
# Each run answers within this budget, inside the console proxy's 120 s first-byte limit.
LLM_TIME_BUDGET_S=100
# LLM runs allowed per rolling hour (0 = no cap); at most 2 run at once.
LLM_RUNS_PER_HOUR=30
