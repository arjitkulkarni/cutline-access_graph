# CUTLINE console (Next.js). Copy to frontend/.env.local for local overrides (never commit .env.local).
# On Vercel set it in Project → Settings → Environment Variables (Production, and Preview if used).
#
# CUTLINE_API_URL — required on Vercel; optional locally (default http://127.0.0.1:8000).
#   The FastAPI backend's origin, no path and no trailing /api. Next.js proxies every browser request for
#   /api/* to it from the server, so the browser never calls the API directly and needs no CORS.
#   Server-side only and read at BUILD time (compiled into the rewrite): redeploy after changing it.
#   Not a secret, but deliberately not NEXT_PUBLIC_: no client code needs it. On Vercel it must be https://.
#   Never put backend secrets (FalkorDB password, ANTHROPIC_API_KEY) in the frontend.
CUTLINE_API_URL=http://127.0.0.1:8000
